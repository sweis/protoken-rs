# Proto3 wire format tokens for protoken fuzzing.
# Tags are (field_number << 3 | wire_type). The same tag bytes cover both the
# SignedToken envelope (version, algorithm, key_id_type, key_id, payload,
# signature) and the Claims payload (expires_at, not_before, issued_at,
# subject, audience, scope).
tag_field1_varint="\x08"
tag_field2_varint="\x10"
tag_field3_varint="\x18"
tag_field4_len="\x22"
tag_field5_len="\x2a"
tag_field6_len="\x32"

# Key fields (secret_key, public_key).
tag_field2_len="\x12"
tag_field3_len="\x1a"

# Key id types 1-2, algorithms 1-9 (8 is the field 1 tag), and the first invalid one.
val_zero="\x00"
val_one="\x01"
val_two="\x02"
val_three="\x03"
val_four="\x04"
val_five="\x05"
val_six="\x06"
val_seven="\x07"
val_nine="\x09"
val_ten="\x0a"

# Short key and signature lengths.
len_32="\x20"
len_48="\x30"
len_64="\x40"
len_96="\x60"
len_128="\x80\x01"

# Timestamp varint (1700000000)
timestamp="\x80\xe2\xcf\xaa\x06"
